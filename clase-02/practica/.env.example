POSTGRES_DB=ceiot
POSTGRES_USER=ceiot
POSTGRES_PASSWORD=ceiot
# Host port published by Docker Compose; PostgreSQL remains on 5432 inside Compose.
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+asyncpg://ceiot:ceiot@postgres:5432/ceiot
BACKEND_BIND_HOST=127.0.0.1
BACKEND_PUBLIC_HOST=localhost
BACKEND_HOST_PORT=8000
BACKEND_SERVICE_HOST=backend
BACKEND_SERVICE_PORT=8000
FRONTEND_BIND_HOST=127.0.0.1
FRONTEND_PUBLIC_HOST=localhost
FRONTEND_HOST_PORT=5173
CORS_ORIGINS=http://${FRONTEND_PUBLIC_HOST}:${FRONTEND_HOST_PORT}
# The browser calls /api; Vite proxies that path to BACKEND_HOST_URL.
# Inside Docker Compose the backend is reachable by its service name and internal port.
BACKEND_HOST_URL=http://${BACKEND_SERVICE_HOST}:${BACKEND_SERVICE_PORT}
VITE_API_URL=/api
