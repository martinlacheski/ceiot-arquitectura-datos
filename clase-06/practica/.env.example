# Copiá este archivo como .env para personalizar el laboratorio local.
# La clave queda vacía deliberadamente: no guardes credenciales reales en Git.
OPENROUTER_API_KEY=tu_api_key
OPENROUTER_MODEL=openai/gpt-4o-mini
# Tope global de tokens de salida por llamada a OpenRouter (cada flujo pide menos).
OPENROUTER_MAX_COMPLETION_TOKENS=300

# Credenciales exclusivas del laboratorio local, consumidas por Compose.
POSTGRES_USER=ceiot
POSTGRES_PASSWORD=ceiot_local_only
POSTGRES_DB=ceiot_class6
REDIS_PASSWORD=ceiot_redis_local_only

# Puertos publicados solamente sobre 127.0.0.1.
POSTGRES_PORT=5436
REDIS_PORT=6379
SEAWEEDFS_S3_PORT=18333
# Puerto de la aplicación web en 127.0.0.1 (dentro del contenedor sigue siendo 8006).
APP_PORT=8006

# Modelo de embeddings local. El esquema (VECTOR(1024)), el corte coseno y el uso
# sin prefijos están calibrados para bge-m3: cambiarlo no está soportado sin adaptarlos.
MODELO_EMBEDDING=BAAI/bge-m3
# Fragmentos por lote al calcular embeddings (más lote = más memoria).
EMBEDDING_BATCH_SIZE=4

# Recuperación RAG: distancia coseno máxima aceptada y fragmentos máximos por consulta.
RAG_MAX_COSINE_DISTANCE=0.55
RAG_MAX_TOP_K=4

# Carga de PDF: tamaño máximo en MiB y tamaño/solape de los fragmentos en caracteres.
MAX_PDF_MIB=50
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=150

# Recursos del uploader. CPUs es entero: también fija OMP_NUM_THREADS (hilos = CPUs).
UPLOADER_CPUS=2
UPLOADER_MEM_LIMIT=4g

# Segundos de vida de la clave de Redis que carga el loader.
REDIS_TTL_SECONDS=3600
# Bucket S3 de los manuales (loader y uploader).
MANUAL_BUCKET=ceiot-manuales
