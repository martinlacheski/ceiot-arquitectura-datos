# Laboratorio local de Clase 05.
# Credenciales exclusivas para desarrollo local; no deben reutilizarse.
# Copie este archivo como .env y cambie los valores en equipos compartidos.

# MongoDB
MONGO_BIND_HOST=127.0.0.1
MONGO_HOST_PORT=27017
MONGO_DATABASE=ceiot_class5
MONGO_ROOT_USERNAME=ceiot
MONGO_ROOT_PASSWORD=class5-mongo-local
MONGO_MEMORY_LIMIT=768m

# Mongo Express (visor local)
MONGO_EXPRESS_BIND_HOST=127.0.0.1
MONGO_EXPRESS_HOST_PORT=8081
MONGO_EXPRESS_USERNAME=student
MONGO_EXPRESS_PASSWORD=class5-viewer-local
MONGO_EXPRESS_MEMORY_LIMIT=256m

# Redis
REDIS_BIND_HOST=127.0.0.1
REDIS_HOST_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=class5-redis-local
REDIS_DATABASE=0
REDIS_MEMORY_LIMIT=256m

# RedisInsight (visor local; usa las credenciales de Redis)
REDISINSIGHT_BIND_HOST=127.0.0.1
REDISINSIGHT_HOST_PORT=5540
REDISINSIGHT_ALIAS=CEIoT Clase 05
REDISINSIGHT_MEMORY_LIMIT=512m

# Apache Cassandra
# La imagen oficial conserva la autenticación predeterminada del laboratorio.
# CQL queda publicado solo sobre CASSANDRA_BIND_HOST para usar con DBeaver.
CASSANDRA_BIND_HOST=127.0.0.1
CASSANDRA_HOST_PORT=9042
CASSANDRA_CLUSTER_NAME=ceiot-class5-cluster
CASSANDRA_DATACENTER=datacenter1
CASSANDRA_RACK=rack1
CASSANDRA_ENDPOINT_SNITCH=GossipingPropertyFileSnitch
CASSANDRA_NUM_TOKENS=16
# Nombre lógico reservado para los inicializadores y ejemplos posteriores.
CASSANDRA_KEYSPACE=ceiot_class5
CASSANDRA_MAX_HEAP_SIZE=1024M
CASSANDRA_HEAP_NEWSIZE=256M
CASSANDRA_MEMORY_LIMIT=1536m

# Neo4j Community y Browser integrado
NEO4J_HTTP_BIND_HOST=127.0.0.1
NEO4J_HTTP_HOST_PORT=7474
NEO4J_BOLT_BIND_HOST=127.0.0.1
NEO4J_BOLT_HOST_PORT=7687
# La cuenta administrativa inicial debe conservar el usuario neo4j.
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=class5-neo4j-local
NEO4J_DATABASE=ceiotclass5
NEO4J_HEAP_INITIAL_SIZE=256m
NEO4J_HEAP_MAX_SIZE=512m
NEO4J_PAGECACHE_SIZE=256m
NEO4J_MEMORY_LIMIT=1024m

# Deterministic initializer settings
REDIS_PRESENCE_TTL_SECONDS=90
CASSANDRA_REPLICATION_FACTOR=1
